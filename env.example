# Future server-side chatbot provider configuration.
# Never expose secrets in VITE_* variables or browser code.
CHATBOT_API_KEY=
CHATBOT_API_URL=

# Unsplash credentials. Keep both values server-side; do not use VITE_ prefixes.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Optional scaffold analytics placeholders.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
